# Postgres connection string used by Prisma (migrations, seed, studio).
# Copy this file to .env and fill in the real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Clave de la API de Claude (https://console.anthropic.com/settings/keys).
# La usa SOLO el endpoint de clasificación documental
# (POST /contratos/:id/documentos/clasificar). Sin ella el API arranca igual y
# ese endpoint responde 503; el resto funciona con normalidad.
ANTHROPIC_API_KEY="sk-ant-..."
# Secreto para firmar los JWT de sesión. Debe ser una cadena aleatoria larga y
# distinta en cada entorno: quien la tenga puede fabricar un token válido para
# cualquier usuario. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sin ella, POST /auth/login y las rutas protegidas responden 503; el resto del
# API arranca y funciona con normalidad.
JWT_SECRET="cambiar-por-una-cadena-aleatoria-larga"
# Orígenes autorizados a llamar al API desde un navegador (CORS). Varios se
# separan por coma. En desarrollo es el de apps/web (`next dev` → puerto 3000).
# Si falta, NINGÚN origen queda autorizado: falla cerrado a propósito.
CORS_ORIGIN="http://localhost:3000"
