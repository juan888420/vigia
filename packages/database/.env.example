# Postgres connection string used by Prisma (migrations, seed, studio).
# Copy this file to .env and fill in the real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Clave de la API de Claude (https://console.anthropic.com/settings/keys).
# La usa SOLO el endpoint de clasificación documental
# (POST /contratos/:id/documentos/clasificar). Sin ella el API arranca igual y
# ese endpoint responde 503; el resto funciona con normalidad.
ANTHROPIC_API_KEY="sk-ant-..."
